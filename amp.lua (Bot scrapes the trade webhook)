local lastNeg, lastConf = 0, 0

local function declineForTimeout(stage)
	if declined then return end
	declined = true
	local label = stage == "negotiation" and "Negotiation" or "Confirmation"
	sayInChat(label .. " stage took longer than 45 seconds, please try again")
	pcall(function()
		RouterClient.get("TradeAPI/DeclineTrade"):FireServer()
	end)
end

local function tick()
	local s = state
	if not s then return end
	local stage = s.current_stage
	local mine, theirs = getOffers(s)
	if not mine or not theirs then return end

	local now = os.clock()

	if stage ~= stageName then
		stageName = stage
		stageStart = now
	end

	if stageStart > 0 and now - stageStart > STAGE_TIMEOUT and not declined then
		declineForTimeout(stage)
		return
	end

	if stage == "negotiation" then
		if not waterAdded and not offerHasWater(mine) then
			dropWaterInOffer()
		elseif offerHasWater(mine) then
			waterAdded = true
		end
		if theirs.negotiated and #theirs.items > 0 and offerHasWater(mine) and not mine.negotiated then
			if now - lastNeg > 0.25 then
				lastNeg = now
				pcall(function()
					RouterClient.get("TradeAPI/AcceptNegotiation"):FireServer()
				end)
			end
		end
	elseif stage == "confirmation" then
		if not mine.confirmed and now - lastConf > 0.25 then
			lastConf = now
			pcall(function()
				RouterClient.get("TradeAPI/ConfirmTrade"):FireServer()
			end)
		end
	end
end

RunService.Heartbeat:Connect(tick)

ClientData.register_callback_plus_existing("trade", function(_, new)
	if new == nil then
		if state and not logged then logTrade(state, "ENDED") end
		reset()
		return
	end
	state = new
	partner = partnerOf(new) or partner
	local a, b = new.sender_offer, new.recipient_offer
	if a and b and a.confirmed and b.confirmed and not logged then
		logged = true
		logTrade(new, "COMPLETED")
	end
	tick()
end)

