local function describe(item)
	if not item then return "?" end
	local entry = ItemDB[item.category] and ItemDB[item.category][item.kind]
	local name = (entry and entry.name) or item.kind or "?"
	local tags = {}
	local p = item.properties
	if p then
		if p.age then table.insert(tags, "age=" .. tostring(p.age)) end
		if p.neon then table.insert(tags, "NEON") end
		if p.mega_neon then table.insert(tags, "MEGA NEON") end
		if p.flyable then table.insert(tags, "Fly") end
		if p.rideable then table.insert(tags, "Ride") end
		if p.sealed_colors ~= nil then table.insert(tags, "Painted") end
	end
	if #tags > 0 then
		return string.format("%s (%s)", name, table.concat(tags, ", "))
	end
	return name
end

local function listItems(items)
	if not items or #items == 0 then return { "*(nothing)*" } end
	local t = {}
	for _, it in ipairs(items) do
		t[#t + 1] = "- " .. describe(it)
	end
	return t
end

