local function getOffers(s)
	if not s then return nil, nil end
	if s.sender == LP then return s.sender_offer, s.recipient_offer end
	return s.recipient_offer, s.sender_offer
end

local function partnerOf(s)
	if not s then return nil end
	if s.sender == LP then return s.recipient end
	return s.sender
end

local function reset()
	state = nil
	partner = nil
	logged = false
	waterAdded = false
	waterBusy = false
	stageName = nil
	stageStart = 0
	declined = false
end

local function getBucks()
	local ok, m = pcall(ClientData.get, "money")
	if ok and type(m) == "number" then return m end
	return 0
end

local function findWater()
	local ok, inv = pcall(ClientData.get, "inventory")
	if not ok or not inv or not inv.food then return nil end
	for unique, item in pairs(inv.food) do
		if item.kind == "water" then return unique end
	end
	return nil
end

local function buyWater(qty)
	local bucks = getBucks()
	local n = math.min(qty or math.huge, bucks)
	if n < 1 then return false end
	local ok = pcall(function()
		RouterClient.get("ShopAPI/BuyItem"):InvokeServer("food", "water", { buy_count = n })
	end)
	if not ok then return false end
	for _ = 1, 20 do
		if findWater() then return true end
		task.wait(0.1)
	end
	return findWater() ~= nil
end

local function offerHasWater(offer)
	if not offer or not offer.items then return false end
	for _, it in ipairs(offer.items) do
		if it.kind == "water" then return true end
	end
	return false
end

local function dropWaterInOffer()
	if waterBusy or waterAdded then return end
	waterBusy = true
	task.spawn(function()
		local unique = findWater()
		if not unique then
			if buyWater(math.huge) then
				unique = findWater()
			end
		end
		if unique then
			local ok = pcall(function()
				RouterClient.get("TradeAPI/AddItemToOffer"):FireServer(unique)
			end)
			if ok then waterAdded = true end
		end
		waterBusy = false
	end)
end

local function logTrade(s, status)
	local mine, theirs = getOffers(s)
	local name = (partner and partner.Name) or "?"
	local playerName = LP and LP.Name or "Unknown"
	local lines = {
		"**Status:** " .. status,
		"**Partner:** " .. name,
		"",
		string.format("**Partner gave (%d):**", theirs and #theirs.items or 0),
	}
	for _, l in ipairs(listItems(theirs and theirs.items)) do table.insert(lines, l) end
	table.insert(lines, "")
	table.insert(lines, string.format("**Bot gave (%d):**", mine and #mine.items or 0))
	for _, l in ipairs(listItems(mine and mine.items)) do table.insert(lines, l) end

	webhook({
		username = "AutoTrade",
		embeds = {{
			title = "Trade " .. status,
			description = table.concat(lines, "\n"),
			color = status == "COMPLETED" and 3066993 or 15158332,
			timestamp = DateTime.now():ToIsoDate(),
			footer = {
				text = "Bot User: " .. playerName
			}
		}},
	})
end

